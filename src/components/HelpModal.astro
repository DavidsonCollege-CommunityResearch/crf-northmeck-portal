---
---
<!-- ════ HELP MODAL (Report an issue / Give feedback) ════ -->
<iframe name="helpHiddenIframe" style="display:none;"></iframe>

<div class="help-modal" id="helpModal" aria-hidden="true">
  <div class="help-backdrop" onclick="closeHelpForm()"></div>
  <div class="help-dialog" role="dialog" aria-modal="true" aria-label="Report an issue or give feedback">
    <button class="help-close" onclick="closeHelpForm()" aria-label="Close"><i class="ti ti-x"></i></button>

    <div class="help-tabs" role="tablist">
      <button class="help-tab" id="helpTabIssue" role="tab" onclick="switchHelpTab('issue')">
        <i class="ti ti-alert-triangle"></i> Report an issue
      </button>
      <button class="help-tab" id="helpTabFeedback" role="tab" onclick="switchHelpTab('feedback')">
        <i class="ti ti-message-dots"></i> Give feedback
      </button>
    </div>

    <!-- ISSUE FORM -->
    <!-- TODO: replace the action URL below with your deployed Apps Script Web App URL -->
    <form id="helpFormIssue" class="help-form"
          method="POST"
          action="PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE"
          target="helpHiddenIframe"
          onsubmit="handleHelpSubmit('issue')">
      <input type="hidden" name="formType" value="issue" />
      <input type="hidden" name="urlPath" id="issueUrlPath" />

      <div class="help-head">
        <h3>Report an issue</h3>
        <p>Broken chart, dead link, wrong number, something that just looks off — tell us where and what.</p>
      </div>

      <div class="help-field">
        <label for="issuePage">Where did this happen? <span class="req">*</span></label>
        <select id="issuePage" name="pageReported" required>
          <option value="" disabled selected>Select a page</option>
          <option>Home</option>
          <option>Housing</option>
          <option>Education</option>
          <option>Healthcare</option>
          <option>Topics</option>
          <option>Data Library</option>
          <option>Sources</option>
          <option>Stories</option>
          <option>United Neighborhoods</option>
          <option>About</option>
          <option>Glossary</option>
          <option>Other / not sure</option>
        </select>
      </div>

      <div class="help-field">
        <label for="issueType">What kind of issue is it? <span class="req">*</span></label>
        <select id="issueType" name="issueType" required>
          <option value="" disabled selected>Select a type</option>
          <option>Broken chart or map</option>
          <option>Broken link or button</option>
          <option>Missing or incorrect data</option>
          <option>Typo or wording error</option>
          <option>Layout or display problem</option>
          <option>Site is slow or won't load</option>
          <option>Other</option>
        </select>
      </div>

      <div class="help-field">
        <label for="issueDate">When did you notice it?</label>
        <input type="date" id="issueDate" name="dateNoticed" />
      </div>

      <div class="help-field">
        <label for="issueDesc">Describe what happened <span class="req">*</span></label>
        <textarea id="issueDesc" name="description" rows="4" required placeholder="What did you see? What did you expect instead?"></textarea>
      </div>

      <div class="help-field">
        <label for="issueEmail">Your email <span class="opt">(optional, if you'd like a reply)</span></label>
        <input type="email" id="issueEmail" name="email" placeholder="you@example.com" />
      </div>

      <button type="submit" class="help-submit" id="issueSubmitBtn">Send report</button>
      <div class="help-success" id="helpSuccessIssue">
        <i class="ti ti-circle-check"></i> Thanks — we've got it and will take a look.
      </div>
    </form>

    <!-- FEEDBACK FORM -->
    <!-- TODO: replace the action URL below with your deployed Apps Script Web App URL (same URL as the issue form) -->
    <form id="helpFormFeedback" class="help-form" style="display:none"
          method="POST"
          action="PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE"
          target="helpHiddenIframe"
          onsubmit="handleHelpSubmit('feedback')">
      <input type="hidden" name="formType" value="feedback" />
      <input type="hidden" name="urlPath" id="feedbackUrlPath" />

      <div class="help-head">
        <h3>Give feedback</h3>
        <p>Reactions, suggestions, things you wish the site did — we read all of it.</p>
      </div>

      <div class="help-field">
        <label for="feedbackType">What kind of feedback? <span class="req">*</span></label>
        <select id="feedbackType" name="feedbackType" required>
          <option value="" disabled selected>Select a type</option>
          <option>Suggestion for a new feature</option>
          <option>Something I liked</option>
          <option>General reaction</option>
          <option>Other</option>
        </select>
      </div>

      <div class="help-field">
        <label for="feedbackMsg">Your feedback <span class="req">*</span></label>
        <textarea id="feedbackMsg" name="message" rows="5" required placeholder="Tell us what's on your mind"></textarea>
      </div>

      <div class="help-field">
        <label for="feedbackEmail">Your email <span class="opt">(optional, if you'd like a reply)</span></label>
        <input type="email" id="feedbackEmail" name="email" placeholder="you@example.com" />
      </div>

      <button type="submit" class="help-submit" id="feedbackSubmitBtn">Send feedback</button>
      <div class="help-success" id="helpSuccessFeedback">
        <i class="ti ti-circle-check"></i> Thanks — we appreciate it.
      </div>
    </form>

  </div>
</div>
