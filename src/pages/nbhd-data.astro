---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---
<BaseLayout title="Neighborhood Data · North Meck Insights">

<div class="page active" style="display:block">

  <div class="wrap">
    <div class="crumb"><a onclick={`window.location='${base}index.html'`}>Home</a><i class="ti ti-chevron-right"></i><a onclick={`window.location='${base}neighborhoods.html'`}>United Neighborhoods</a><i class="ti ti-chevron-right"></i><span id="nbhd-data-crumb">Pottstown</span></div>
    <div class="dash-hero" style="margin-bottom:36px">
      <div>
        <span class="eyebrow" style="font-size:15px">United Neighborhoods · Data Dashboard</span>
        <h1 class="dash-h1" id="nbhd-data-title">Pottstown</h1>
        <p class="lead dash-lead" style="margin-bottom:0" id="nbhd-data-subtitle">Block-group level ACS data for the Pottstown area in Huntersville.</p>
      </div>
    </div>

    <!-- Neighborhood selector -->
    <div class="nbhd-selector" style="margin-bottom:24px">
      <button class="nbhd-sel-btn active" data-nbhd="pottstown"       onclick="setNbhdData(this)">Pottstown</button>
      <button class="nbhd-sel-btn"        data-nbhd="westdavidson"    onclick="setNbhdData(this)">West Davidson</button>
      <button class="nbhd-sel-btn"        data-nbhd="smithville"      onclick="setNbhdData(this)">Smithville</button>
      <button class="nbhd-sel-btn"        data-nbhd="huntingtongreen" onclick="setNbhdData(this)">Huntington Green</button>
      <button class="nbhd-sel-btn no-data" data-nbhd="eastcatawba"   onclick="setNbhdData(this)">East Catawba</button>
    </div>

    <!-- Block-group disclaimer -->
    <div class="nbhd-disclaimer">
      <i class="ti ti-info-circle"></i>
      <div id="nbhd-disclaimer-text"><strong>Data note:</strong> Neighborhood boundaries don't align perfectly with U.S. Census geography. The data shown here is from the <strong>ACS block group</strong> that best approximates each neighborhood — the smallest geographic unit the Census publishes. This means the numbers may include some residents just outside the neighborhood boundary. All data comes from the American Community Survey 5-year estimates.</div>
    </div>

    <!-- Sub-topic tabs -->
    <div class="tabs" id="nbhd-data-tabs">
      <span class="tab active" data-tab="nd-demographics"  onclick="setTab(this)">Demographics</span>
      <span class="tab"        data-tab="nd-economic"      onclick="setTab(this)">Economic Profile</span>
      <span class="tab"        data-tab="nd-housing"       onclick="setTab(this)">Housing</span>
      <span class="tab"        data-tab="nd-education"     onclick="setTab(this)">Education</span>
      <span class="tab"        data-tab="nd-transportation" onclick="setTab(this)">Transportation</span>
      <span class="tab"        data-tab="nd-childcare"     onclick="setTab(this)">Childcare</span>
    </div>
  </div>

  <!-- ── EAST CATAWBA: no data ── -->
  <div id="nbhd-panel-eastcatawba" class="nbhd-panel">
    <div class="wrap">
      <div class="nbhd-no-data" style="margin-top:48px">
        <i class="ti ti-database-off"></i>
        <div class="nbhd-no-data-h">Data not yet available for East Catawba</div>
        <p class="nbhd-no-data-p">East Catawba is the fifth United Neighborhood. We are still collecting and verifying block-group data for this area. Check back as the research progresses, or explore the neighborhood's history in the <a onclick={`window.location='${base}neighborhoods.html#nbhd-eastcatawba'`} style="color:var(--accent);cursor:pointer">neighborhood overview</a>.</p>
      </div>
    </div>
  </div>

  <!-- ── DATA PANELS (shared for all 4 data neighborhoods) ── -->
  <div id="nbhd-panel-data" class="nbhd-panel active">

    <!-- TAB: Demographics -->
    <div class="tabpane active" data-pane="nd-demographics">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Population &amp; Ethnicity</div>
          <p class="nbhd-sub-lead">Total population and Hispanic or Latino population share of the block groups approximating this neighborhood, from ACS 5-year estimates.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Total Population</div>
              <div class="card-s">Summed across all block groups that approximate this neighborhood</div>
              <div id="nd-pop-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Hispanic or Latino Population Rate</div>
              <div class="card-s">% of residents identifying as Hispanic or Latino</div>
              <div id="nd-hl-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
          </div>
        </div>
        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Race</div>
          <p class="nbhd-sub-lead">Share of the population by race, most recent ACS year.</p>
          <div class="card viz-host">
            <div class="card-t">Racial &amp; Ethnic Composition</div>
            <div class="card-s">Share of population by race/ethnicity, most recent ACS year</div>
            <div id="nd-race-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Economic Profile -->
    <div class="tabpane" data-pane="nd-economic">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Income</div>
          <p class="nbhd-sub-lead">Household income distribution and median household income for residents in this block group.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Household Income Distribution</div>
              <div class="card-s">Share of households in each income bracket, most recent ACS year</div>
              <div id="nd-income-dist-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Median Household Income</div>
              <div class="card-s">Median household income in dollars</div>
              <div id="nd-income-trend-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
          </div>
        </div>
        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Income Over Time</div>
          <p class="nbhd-sub-lead">How the income bracket mix has shifted since 2020, and how the number of households has grown alongside it.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Household Income Distribution Over Time</div>
              <div class="card-s">Share of households in each income bracket, by year</div>
              <div id="nd-income-dist-trend-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Total Households Over Time</div>
              <div class="card-s">Number of households, by year</div>
              <div id="nd-total-households-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Housing -->
    <div class="tabpane" data-pane="nd-housing">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Tenure &amp; Home Values</div>
          <p class="nbhd-sub-lead">Who owns versus rents in this neighborhood, and how home values and rents compare.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Owner vs. Renter Occupied</div>
              <div class="card-s">Share of occupied housing units by tenure, most recent ACS year</div>
              <div id="nd-tenure-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Median Gross Rent &amp; Home Value</div>
              <div class="card-s">Most recent ACS estimate</div>
              <div id="nd-rent-value-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
          </div>
        </div>
        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Cost Burden</div>
          <p class="nbhd-sub-lead">Share of renter households spending 30%+ of income on rent — the standard definition of cost-burdened.</p>
          <div class="card viz-host">
            <div class="card-t">Housing Cost Burden Rate</div>
            <div class="card-s">% of renter households paying ≥30% of income on rent</div>
            <div id="nd-burden-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Education -->
    <div class="tabpane" data-pane="nd-education">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Educational Attainment</div>
          <p class="nbhd-sub-lead">Highest level of education completed by residents 25 and older in this neighborhood, and how that mix has shifted since 2020.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Educational Attainment Composition Over Time</div>
              <div class="card-s">Share of adults 25+ by highest level completed, by year</div>
              <div id="nd-attainment-composition-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Bachelor's Degree or Higher Rate</div>
              <div class="card-s">% of adults 25+ with a bachelor's degree or above</div>
              <div id="nd-bachelors-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
          </div>
        </div>
        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Attainment Trends</div>
          <p class="nbhd-sub-lead">Two ends of the same scale: how many adults live here, and whether the share without a high school diploma is growing or shrinking.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Population 25+ Over Time</div>
              <div class="card-s">Number of residents age 25 and older, by year</div>
              <div id="nd-pop25-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Less Than High School Rate Over Time</div>
              <div class="card-s">% of adults 25+ without a high school diploma or equivalent</div>
              <div id="nd-less-hs-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Transportation -->
    <div class="tabpane" data-pane="nd-transportation">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Commute Mode</div>
          <p class="nbhd-sub-lead">How residents get to work: driving alone, transit, walking, cycling, or working from home, and how that mix has shifted since 2018.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Commute Mode Share</div>
              <div class="card-s">% of workers by primary mode of transportation, most recent <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> year</div>
              <div id="nd-commute-mode-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Commute Mode Over Time</div>
              <div class="card-s">Share of workers driving alone, using public transit, or working from home, by year</div>
              <div id="nd-commute-trend-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
          </div>
        </div>

        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Remote Work &amp; Workforce</div>
          <p class="nbhd-sub-lead">Remote work reshaped commuting patterns nationally after 2020. Tracking it locally shows how much of that shift reached this neighborhood, and how its working-age population has grown alongside it.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Remote Work Adoption Over Time</div>
              <div class="card-s">% of workers working from home, by year</div>
              <div id="nd-remote-work-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Total Workers Over Time</div>
              <div class="card-s">Number of employed residents age 16 and over, by year</div>
              <div id="nd-total-workers-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
              <div class="callout">
                <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Childcare -->
    <div class="tabpane" data-pane="nd-childcare">
      <div class="wrap">
        <div class="nbhd-sub-section" style="margin-top:40px">
          <div class="nbhd-sub-h">Childcare Need</div>
          <p class="nbhd-sub-lead">Estimated share of young children whose parents are in the labor force — a proxy for households that likely need childcare.</p>
          <div class="g2">
            <div class="card viz-host">
              <div class="card-t">Under-6 Children Likely Needing Childcare</div>
              <div class="card-s">% of children under 6 where all available parents work</div>
              <div id="nd-under6-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
            <div class="card viz-host">
              <div class="card-t">Ages 6–17 Likely Needing After-School Care</div>
              <div class="card-s">% of children 6–17 where all available parents work</div>
              <div id="nd-afterschool-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            </div>
          </div>
        </div>
        <div class="nbhd-sub-section">
          <div class="nbhd-sub-h">Children Under 18</div>
          <p class="nbhd-sub-lead">Total number of children under 18 living in this neighborhood, and how that's changed since 2020.</p>
          <div class="card viz-host">
            <div class="card-t">Total Children Under 18 Over Time</div>
            <div class="card-s">Number of residents under age 18, by year</div>
            <div id="nd-total-under18-chart" style="width:100%"><p style="color:#888;font-family:'Hanken Grotesk',sans-serif;padding:12px">Loading data…</p></div>
            <div class="callout">
              <div class="callout-s">Source: <span class="gloss-link" data-term="acs" role="button" tabindex="0" onclick="glossTerm('acs')">ACS</span> 5-Year Estimates</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /nbhd-panel-data -->

</div>

<Fragment slot="page-scripts">
  <script is:inline type="module" src={`${base}js/neighborhoods.js`}></script>
</Fragment>
</BaseLayout>
