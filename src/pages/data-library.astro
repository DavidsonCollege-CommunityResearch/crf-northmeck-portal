---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---
<BaseLayout title="Data Library · North Meck Insights">

<div class="page active" style="display:block">

  <div class="wrap"><div class="crumb"><a onclick={`window.location='${base}index.html'`}>Home</a><i class="ti ti-chevron-right"></i><span>Data Library</span></div></div>
  <section class="section"><div class="wrap">
    <div class="dlib-hero">
      <span class="dlib-badge">Data Library</span>
      <h1 class="dlib-title">Public datasets from our research, ready to use</h1>
      <p class="dlib-intro">Every number on this portal traces back to a publicly available dataset. Download the data behind our housing, education, healthcare, and neighborhood research as CSV or Excel, with a plain-language codebook for each file. New datasets are added every summer as Fellows publish their research.</p>
    </div>
    <div class="dlib-filter">
      <span class="dlib-filter-label">Filter by</span>
      <div class="dlib-search"><input type="text" id="dlibSearch" placeholder="Search datasets" oninput="dlibFilter()" aria-label="Search datasets"></div>
      <div class="dlib-dd" data-key="topic">
        <button class="dlib-dd-btn" data-label="Topic" onclick="dlibToggle(this)" aria-haspopup="listbox"><span class="dlib-dd-txt">Topic</span><i class="ti ti-chevron-down"></i></button>
        <div class="dlib-dd-menu" role="listbox">
          <div class="dlib-dd-opt on" data-val="all" onclick="dlibPick(this)">All topics</div>
          <div class="dlib-dd-opt" data-val="housing" onclick="dlibPick(this)">Housing &amp; Affordability</div>
          <div class="dlib-dd-opt" data-val="demographics" onclick="dlibPick(this)">Demographics</div>
          <div class="dlib-dd-opt" data-val="economics" onclick="dlibPick(this)">Economic Well-Being</div>
          <div class="dlib-dd-opt" data-val="education" onclick="dlibPick(this)">Education</div>
          <div class="dlib-dd-opt" data-val="healthcare" onclick="dlibPick(this)">Healthcare</div>
          <div class="dlib-dd-opt" data-val="transportation" onclick="dlibPick(this)">Transportation</div>
          <div class="dlib-dd-opt" data-val="neighborhoods" onclick="dlibPick(this)">Neighborhoods</div>
          <div class="dlib-dd-opt" data-val="facilities" onclick="dlibPick(this)">Facilities &amp; Resources</div>
        </div>
      </div>
      <div class="dlib-dd" data-key="geo">
        <button class="dlib-dd-btn" data-label="Level of detail" onclick="dlibToggle(this)" aria-haspopup="listbox"><span class="dlib-dd-txt">Level of detail</span><i class="ti ti-chevron-down"></i></button>
        <div class="dlib-dd-menu" role="listbox">
          <div class="dlib-dd-opt on" data-val="all" onclick="dlibPick(this)">All levels</div>
          <div class="dlib-dd-opt" data-val="town" onclick="dlibPick(this)">Town (annual trend)</div>
          <div class="dlib-dd-opt" data-val="bracket" onclick="dlibPick(this)">Income bracket (2024)</div>
          <div class="dlib-dd-opt" data-val="county" onclick="dlibPick(this)">County</div>
          <div class="dlib-dd-opt" data-val="neighborhood" onclick="dlibPick(this)">Neighborhood</div>
          <div class="dlib-dd-opt" data-val="school" onclick="dlibPick(this)">School</div>
          <div class="dlib-dd-opt" data-val="facility" onclick="dlibPick(this)">Facility location</div>
        </div>
      </div>
      <div class="dlib-dd" data-key="theme">
        <button class="dlib-dd-btn" data-label="Theme" onclick="dlibToggle(this)" aria-haspopup="listbox"><span class="dlib-dd-txt">Theme</span><i class="ti ti-chevron-down"></i></button>
        <div class="dlib-dd-menu" role="listbox">
          <div class="dlib-dd-opt on" data-val="all" onclick="dlibPick(this)">All themes</div>
          <div class="dlib-dd-opt" data-val="affordability" onclick="dlibPick(this)">Affordability</div>
          <div class="dlib-dd-opt" data-val="economic-mobility" onclick="dlibPick(this)">Economic mobility</div>
          <div class="dlib-dd-opt" data-val="racial-equity" onclick="dlibPick(this)">Racial equity</div>
          <div class="dlib-dd-opt" data-val="demographics" onclick="dlibPick(this)">Demographics</div>
        </div>
      </div>
    </div>
    <div class="dlib-results" id="dlibResults">

      <div class="dlib-section"><h2 class="dlib-section-h">Housing &amp; Affordability</h2>
        <div class="dlib-row" id="dlib-economic-trends" data-id="economic-trends" data-name="economic trends rent income home values by town 2018-2024" data-geo="town" data-topic="housing economics" data-theme="affordability economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Rent, income &amp; home values by town (2018–2024)</div><div class="dlib-row-desc">Median gross rent, household income, and home values for Cornelius, Davidson, and Huntersville — the foundation for all affordability analysis on the portal. Includes affordability ratios and income inequality (Gini).</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-housing-burden" data-id="housing-burden" data-name="housing cost burden renter severely burdened by town 2018-2024" data-geo="town" data-topic="housing" data-theme="affordability"><div class="dlib-row-info"><div class="dlib-row-name">Housing cost burden by town (2018–2024)</div><div class="dlib-row-desc">Share of renter households spending 30%+ and 50%+ of income on housing, with household counts. Shows how displacement pressure has grown in each town since 2018.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-burden-by-bracket" data-id="burden-by-bracket" data-name="cost burden by income bracket renter owner 2024" data-geo="bracket" data-topic="housing" data-theme="affordability"><div class="dlib-row-info"><div class="dlib-row-name">Cost burden by income bracket, renter &amp; owner (2024)</div><div class="dlib-row-desc">Household counts by town, tenure (renter/owner), income bracket, and burden level — reveals which income groups face the most severe housing cost pressure. Key for targeting policy interventions.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="dlib-tag">Income bracket · 2024</span><span class="dlib-tag">ACS CHAS / HUD</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-ptr-by-bracket" data-id="ptr-by-bracket" data-name="home price to income ratio years to buy by income bracket 2024" data-geo="bracket" data-topic="housing economics" data-theme="affordability"><div class="dlib-row-info"><div class="dlib-row-name">Home purchase affordability by income bracket (2024)</div><div class="dlib-row-desc">Years of gross income needed to buy the median home in each town, calculated for every income bracket. Shows how far homeownership is out of reach at different points on the income spectrum.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="dlib-tag">Income bracket · 2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
      </div>

      <div class="dlib-section"><h2 class="dlib-section-h">Demographics &amp; Income</h2>
        <div class="dlib-row" id="dlib-demographics" data-id="demographics" data-name="population households racial composition income by town 2018-2024" data-geo="town" data-topic="demographics economics" data-theme="demographics"><div class="dlib-row-info"><div class="dlib-row-name">Population, households &amp; racial composition by town (2018–2024)</div><div class="dlib-row-desc">Total population, household counts, median household income, and racial/ethnic composition (White, Black, Hispanic, Asian, other) for each town by year. Covers North Meck's rapid growth and evolving diversity.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-demographics">Demographics</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
      </div>

      <div class="dlib-section"><h2 class="dlib-section-h">Economic Well-Being</h2>
        <div class="dlib-row" id="dlib-alice-town" data-id="alice-town" data-name="alice households asset limited income constrained employed by town 2024" data-geo="town" data-topic="economics" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">ALICE households by town (2024)</div><div class="dlib-row-desc">Households below the Federal Poverty Level, households above poverty but below the ALICE Threshold (working but unable to afford a basic survival budget), and households above the ALICE Threshold, for each town.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">Town · 2024</span><span class="dlib-tag">United Way ALICE Report</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-alice-county" data-id="alice-county" data-name="alice households mecklenburg county trend 2010-2024" data-geo="county" data-topic="economics" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">ALICE households, Mecklenburg County trend (2010–2024)</div><div class="dlib-row-desc">The same ALICE breakdown as the town-level dataset, but for Mecklenburg County as a whole across ten reporting years, showing how financial hardship has shifted county-wide over time.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">County · 2010–2024</span><span class="dlib-tag">United Way ALICE Report</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-economic-mobility" data-id="economic-mobility" data-name="economic mobility education poverty unemployment by town 2018-2024" data-geo="town" data-topic="economics education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Education, poverty &amp; unemployment by town (2018–2024)</div><div class="dlib-row-desc">Bachelor's/master's attainment rate, poverty rate, and unemployment rate for each town by year — three indicators commonly used together as a rough read on economic mobility.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
      </div>

      <div class="dlib-section"><h2 class="dlib-section-h">Education</h2>
        <div class="dlib-row" id="dlib-school-proficiency" data-id="school-proficiency" data-name="grade level proficiency college career readiness by school 2024" data-geo="school" data-topic="education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Grade-level proficiency &amp; college/career readiness by school (2024)</div><div class="dlib-row-desc">Grade-Level Proficient rate and College/Career Ready rate for every North Meck school, with Title I status and grade span.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-growth" data-id="school-growth" data-name="school academic growth evaas index by school 2024" data-geo="school" data-topic="education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Academic growth by school (2024)</div><div class="dlib-row-desc">State growth status and EVAAS growth index for every North Meck school — measures year-over-year student progress, not absolute achievement level.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-graduation" data-id="school-graduation" data-name="four year graduation rate by high school 2024" data-geo="school" data-topic="education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Four-year graduation rate by high school (2024)</div><div class="dlib-row-desc">Four-year cohort graduation rate for every North Meck high school. High-school level only.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-economic-gap" data-id="school-economic-gap" data-name="achievement gap by economic disadvantage school 2024" data-geo="school" data-topic="education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Achievement gap by economic disadvantage, all schools (2024)</div><div class="dlib-row-desc">Grade-Level Proficient rate for economically disadvantaged vs. non-disadvantaged students at every North Meck school, with the resulting percentage-point gap.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-hs-economic-gap" data-id="school-hs-economic-gap" data-name="achievement gap by economic disadvantage high school 2024" data-geo="school" data-topic="education" data-theme="economic-mobility"><div class="dlib-row-info"><div class="dlib-row-name">Achievement gap by economic disadvantage, high schools (2024)</div><div class="dlib-row-desc">Same comparison as the all-schools economic gap dataset, limited to high schools.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-economic-mobility">Economic mobility</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-race-gap" data-id="school-race-gap" data-name="proficiency gap by race school 2024" data-geo="school" data-topic="education" data-theme="racial-equity"><div class="dlib-row-info"><div class="dlib-row-name">Proficiency gap by race, by school (2024)</div><div class="dlib-row-desc">Grade-Level Proficient rate for White students compared against Black, Hispanic, Asian, American Indian, and Two-or-More-Races students at each school where enough students are enrolled to report.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-racial-equity">Racial equity</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-disability-gap" data-id="school-disability-gap" data-name="proficiency gap students with disabilities school 2024" data-geo="school" data-topic="education" data-theme="demographics"><div class="dlib-row-info"><div class="dlib-row-name">Proficiency gap, students with disabilities, by school (2024)</div><div class="dlib-row-desc">Grade-Level Proficient rate for students with disabilities compared to students without, at every North Meck school.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-demographics">Demographics</span><span class="dlib-tag">School · 2024</span><span class="dlib-tag">NC School Report Cards</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
        <div class="dlib-row" id="dlib-school-enrollment" data-id="school-enrollment" data-name="population growth k12 enrollment by town 2018-2024" data-geo="town" data-topic="education" data-theme="demographics"><div class="dlib-row-info"><div class="dlib-row-name">Population growth vs. K-12 enrollment by town (2018–2024)</div><div class="dlib-row-desc">Total population age 3+, K-12 enrollment, and total school enrollment (all levels) for residents of each town by year.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-demographics">Demographics</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
      </div>

      <div class="dlib-section"><h2 class="dlib-section-h">Healthcare</h2>
        <div class="dlib-row" id="dlib-healthcare-insurance" data-id="healthcare-insurance" data-name="health insurance coverage by age employment income town 2024" data-geo="town" data-topic="healthcare" data-theme="affordability"><div class="dlib-row-info"><div class="dlib-row-name">Health insurance coverage by town (2024)</div><div class="dlib-row-desc">Insurance and uninsurance counts broken out by age group, coverage type, employment status, and household income bracket, for each town.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="dlib-tag">Town · 2024</span><span class="dlib-tag">ACS Table B27010</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
      </div>

      <div class="dlib-section"><h2 class="dlib-section-h">Transportation</h2>
        <div class="dlib-row" id="dlib-infrastructure-access" data-id="infrastructure-access" data-name="vehicle access internet insurance rates by town 2018-2024" data-geo="town" data-topic="transportation healthcare" data-theme="affordability"><div class="dlib-row-info"><div class="dlib-row-name">Vehicle access, internet &amp; insurance rates by town (2018–2024)</div><div class="dlib-row-desc">Share of renter and owner households with no vehicle, households with no internet subscription, and uninsurance rates for the labor force and for seniors, by town and year.</div><div class="dlib-row-meta"><span class="theme-pill dlib-theme-tag theme-affordability">Affordability</span><span class="dlib-tag">Town · 2018–2024</span><span class="dlib-tag">ACS 5-yr estimates</span></div></div><div class="dlib-row-actions"><button class="dlib-dl" onclick="dlibDownload(event,'CSV')"><i class="ti ti-file-text"></i> CSV</button><button class="dlib-dl" onclick="dlibDownload(event,'Excel')"><i class="ti ti-table"></i> Excel</button><button class="dlib-dl dlib-cb" onclick="dlibDownload(event,'Codebook')"><i class="ti ti-book-2"></i> Codebook</button></div></div>
