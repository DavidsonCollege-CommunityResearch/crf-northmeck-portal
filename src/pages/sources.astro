---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---
<BaseLayout title="Sources · North Meck Insights">

<div class="page active" style="display:block">

  <div class="wrap"><div class="crumb"><a onclick={`window.location='${base}index.html'`}>Home</a><i class="ti ti-chevron-right"></i><span>Sources</span></div></div>
  <section class="section"><div class="wrap">
    <div class="sec-head" style="max-width:680px">
      <span class="eyebrow" style="font-size:15px">Sources</span>
      <h2 class="sec-h" style="font-size:32px">Every source, in one place</h2>
      <p class="lead">A full bibliography of the open public data behind the portal. Each number on the site traces back to one of these. Open data only, all of it free to verify and download.</p>
    </div>
    <div class="biblio">
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">Federal agencies</div>
        <div class="cite"><div class="cite-num">01</div><div class="cite-body"><div class="cite-t">American Community Survey (ACS), 5-year estimates</div><div class="cite-pub">U.S. Census Bureau · 2024 release</div><div class="cite-meta"><a class="cite-link" href="https://data.census.gov" target="_blank" rel="noopener">data.census.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">02</div><div class="cite-body"><div class="cite-t">FY2025 Income Limits</div><div class="cite-pub">U.S. Dept. of Housing &amp; Urban Development (HUD)</div><div class="cite-meta"><a class="cite-link" href="https://www.huduser.gov/portal/datasets/il.html" target="_blank" rel="noopener">huduser.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">03</div><div class="cite-body"><div class="cite-t">FY2025 Fair Market Rents</div><div class="cite-pub">HUD · Charlotte-Concord-Gastonia MSA</div><div class="cite-meta"><a class="cite-link" href="https://www.huduser.gov/portal/datasets/fmr.html" target="_blank" rel="noopener">huduser.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">04</div><div class="cite-body"><div class="cite-t">PLACES: Local Data for Better Health</div><div class="cite-pub">Centers for Disease Control and Prevention (CDC)</div><div class="cite-meta"><a class="cite-link" href="https://www.cdc.gov/places/" target="_blank" rel="noopener">cdc.gov/places <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">05</div><div class="cite-body"><div class="cite-t">Behavioral Health Treatment Services Locator</div><div class="cite-pub">Substance Abuse and Mental Health Services Administration (SAMHSA)</div><div class="cite-meta"><a class="cite-link" href="https://findtreatment.gov" target="_blank" rel="noopener">findtreatment.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">06</div><div class="cite-body"><div class="cite-t">Occupational Employment &amp; Wage Statistics (OEWS)</div><div class="cite-pub">U.S. Bureau of Labor Statistics (BLS)</div><div class="cite-meta"><a class="cite-link" href="https://www.bls.gov/oes/" target="_blank" rel="noopener">bls.gov/oes <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">07</div><div class="cite-body"><div class="cite-t">EDFacts</div><div class="cite-pub">U.S. Dept. of Education, National Center for Education Statistics</div><div class="cite-meta"><a class="cite-link" href="https://eddataexpress.ed.gov" target="_blank" rel="noopener">eddataexpress.ed.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
      </div>
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">State agencies</div>
        <div class="cite"><div class="cite-num">08</div><div class="cite-body"><div class="cite-t">School Report Card data</div><div class="cite-pub">NC Department of Public Instruction</div><div class="cite-meta"><a class="cite-link" href="https://www.dpi.nc.gov/data-reports/school-report-cards" target="_blank" rel="noopener">dpi.nc.gov <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
      </div>
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">Research &amp; data providers</div>
        <div class="cite"><div class="cite-num">09</div><div class="cite-body"><div class="cite-t">Out of Reach 2025</div><div class="cite-pub">National Low Income Housing Coalition (NLIHC)</div><div class="cite-meta"><a class="cite-link" href="https://nlihc.org/oor" target="_blank" rel="noopener">nlihc.org <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">10</div><div class="cite-body"><div class="cite-t">ALICE Economic Viability Dashboard</div><div class="cite-pub">United Way of North Carolina</div><div class="cite-meta"><a class="cite-link" href="https://www.unitedforalice.org" target="_blank" rel="noopener">unitedforalice.org <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">11</div><div class="cite-body"><div class="cite-t">Principles for Advancing Equitable Data Practice, 2020</div><div class="cite-pub">Urban Institute</div><div class="cite-meta"><a class="cite-link" href="https://www.urban.org/research/publication/principles-advancing-equitable-data-practice" target="_blank" rel="noopener">urban.org <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
        <div class="cite"><div class="cite-num">12</div><div class="cite-body"><div class="cite-t">Beckman &amp; Long, 2016</div><div class="cite-pub">Community-based research methods</div><div class="cite-meta"><a class="cite-link" href="https://www.routledge.com/Community-Based-Research-Teaching-for-Community-Impact/Beckman-Long/p/book/9781620363560" target="_blank" rel="noopener">routledge.com <i class="ti ti-external-link" style="font-size:13px"></i></a></div></div></div>
      </div>
    </div>
    <div class="dlstrip" style="margin-top:52px">
      <div><div class="dlstrip-t">Want the raw data?</div><div class="dlstrip-s">Every chart on the portal is available as CSV, with the source noted inline.</div></div>
      <div class="dl-btns"><button class="btn-ghost" onclick={`window.location='${base}data-library.html'`}><i class="ti ti-download"></i> Download all CSVs</button><button class="btn-ghost"><i class="ti ti-file-text"></i> Methodology PDF</button></div>
    </div>
  </div></section>

</div>
</BaseLayout>
