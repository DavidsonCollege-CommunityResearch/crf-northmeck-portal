---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---
<BaseLayout title="Sources · North Meck Insights">

<div class="page active" style="display:block">

  <div class="wrap"><div class="crumb"><a onclick={`window.location='${base}index.html'`}>Home</a><i class="ti ti-chevron-right"></i><span>Sources</span></div></div>
  <section class="section"><div class="wrap">
    <div class="sec-head" style="max-width:680px">
      <span class="eyebrow" style="font-size:15px">Sources</span>
      <h2 class="sec-h" style="font-size:32px">Every source, in one place</h2>
      <p class="lead">A full bibliography of the open public data behind the portal. Each number on the site traces back to one of these. Open data only, all of it free to verify and download.</p>
    </div>
    <div class="biblio">
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">Federal agencies</div>
        <div class="cite"><div class="cite-num">01</div><div class="cite-body"><div class="cite-t">American Community Survey (ACS), 5-year estimates</div><div class="cite-pub">U.S. Census Bureau · 2024 release</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Demographics, income, housing, health insurance, and education across every dashboard</span><span class="cite-link">data.census.gov <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">02</div><div class="cite-body"><div class="cite-t">FY2025 Income Limits</div><div class="cite-pub">U.S. Dept. of Housing &amp; Urban Development (HUD)</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> AMI thresholds (30% / 50% / 80%)</span><span class="cite-link">huduser.gov <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">03</div><div class="cite-body"><div class="cite-t">FY2025 Fair Market Rents</div><div class="cite-pub">HUD · Charlotte-Concord-Gastonia MSA</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> 1-bed &amp; 2-bed FMR figures</span><span class="cite-link">huduser.gov <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">04</div><div class="cite-body"><div class="cite-t">PLACES: Local Data for Better Health</div><div class="cite-pub">Centers for Disease Control and Prevention (CDC)</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Health outcomes, prevention, risk behaviors, and social needs by town</span><span class="cite-link">cdc.gov/places <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">05</div><div class="cite-body"><div class="cite-t">Behavioral Health Treatment Services Locator</div><div class="cite-pub">Substance Abuse and Mental Health Services Administration (SAMHSA)</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Mental health and substance use treatment facility directory</span><span class="cite-link">findtreatment.gov <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
      </div>
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">State &amp; local</div>
        <div class="cite"><div class="cite-num">06</div><div class="cite-body"><div class="cite-t">School Report Card data</div><div class="cite-pub">NC Department of Public Instruction</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Proficiency, growth, graduation, and achievement gaps by school</span><span class="cite-link">dpi.nc.gov <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">07</div><div class="cite-body"><div class="cite-t">Eviction filing records, FY2025</div><div class="cite-pub">Mecklenburg County</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Filings, orders granted, year-over-year change</span></div></div></div>
        <div class="cite"><div class="cite-num">08</div><div class="cite-body"><div class="cite-t">State of Housing Instability &amp; Homelessness, 2025</div><div class="cite-pub">Charlotte-Mecklenburg</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Disparities by race, NOAH supply loss</span></div></div></div>
      </div>
      <div class="biblio-group">
        <div class="biblio-h" style="font-size:15px">Research &amp; data providers</div>
        <div class="cite"><div class="cite-num">09</div><div class="cite-body"><div class="cite-t">Out of Reach 2025</div><div class="cite-pub">National Low Income Housing Coalition (NLIHC)</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Housing wage ($31.67/hr) &amp; affordability gap</span><span class="cite-link">nlihc.org <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">10</div><div class="cite-body"><div class="cite-t">ALICE Economic Viability Dashboard</div><div class="cite-pub">United Way of North Carolina</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Households below a basic-needs budget, beyond the poverty line alone</span><span class="cite-link">unitedforalice.org <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">11</div><div class="cite-body"><div class="cite-t">Home Value Index (ZHVI) &amp; Observed Rent Index (ZORI)</div><div class="cite-pub">Zillow Research</div><div class="cite-meta"><span class="tag"><i class="ti ti-database"></i> Monthly home value and rent trends by housing type</span><span class="cite-link">zillow.com/research/data <i class="ti ti-external-link" style="font-size:13px"></i></span></div></div></div>
        <div class="cite"><div class="cite-num">12</div><div class="cite-body"><div class="cite-t">Data Equity Framework, 2021</div><div class="cite-pub">Urban Institute</div><div class="cite-meta"><span class="tag"><i class="ti ti-book-2"></i> Methodology for inclusive data practice</span></div></div></div>
        <div class="cite"><div class="cite-num">13</div><div class="cite-body"><div class="cite-t">Beckman &amp; Long, 2016</div><div class="cite-pub">Community-based research methods</div><div class="cite-meta"><span class="tag"><i class="ti ti-book-2"></i> Framework reference</span></div></div></div>
      </div>
    </div>
    <div class="dlstrip" style="margin-top:52px">
      <div><div class="dlstrip-t">Want the raw data?</div><div class="dlstrip-s">Every chart on the portal is available as CSV, with the source noted inline.</div></div>
      <div class="dl-btns"><button class="btn-ghost" onclick={`window.location='${base}data-library.html'`}><i class="ti ti-download"></i> Download all CSVs</button><button class="btn-ghost"><i class="ti ti-file-text"></i> Methodology PDF</button></div>
    </div>
  </div></section>

</div>
</BaseLayout>
